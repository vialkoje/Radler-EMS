# Radler-EMS: Einstellungen, Adressen und Zugangsdaten für Node-RED
# Liegt auf dem Pi als ~/radler-ems/secrets.env (chmod 600), Node-RED liest sie beim Start
# (~/.node-red/environment ist ein Link darauf). NICHT einchecken, nicht weitergeben.
# Nach Änderungen: sudo systemctl restart nodered
# Format: NAME=wert, ohne Leerzeichen um das =, ohne Anführungszeichen. Leer = Standardwert aus dem Code.
# Alle Einstellungen mit Bedeutung: docs/einstellungen.md

# ─── Standort ───
STANDORT_NAME=Standort
STANDORT_LAT=
STANDORT_LON=
STANDORT_HOEHE=

# ─── Woher kommen die Werte? simulator | geraet | aus ───
# simulator: der Tab „🧪 Simulator“ liefert die Werte; geraet: der Adapter im Geräte-Tab; aus: Gerät gibt es nicht
PV_QUELLE=simulator
# Balkonkraftwerk nur, wenn vorhanden (Standard aus)
BKW_QUELLE=aus
NETZ_QUELLE=simulator
BATTERIE_QUELLE=simulator
WALLBOX_QUELLE=simulator
AUTO_QUELLE=simulator
WP_QUELLE=simulator

# ─── Was darf das EMS? aus | beobachten | aktiv ───
# beobachten: rechnen und protokollieren, nichts an die Geräte schicken. Mit echten Geräten erst einmal beobachten!
EMS_MODUS=beobachten
WB_MODUS=beobachten
WP_MODUS=beobachten
# Netzladen: vorschau | beobachten | aus; Wasserlinie und Hausakku beim Autoladen: aktiv | beobachten | aus
NL_MODUS=vorschau
WL_MODUS=beobachten
HA_MODUS=aktiv
WB_PV_MODUS=aktiv

# ─── Anlage ───
# Dachflächen: Neigung/Azimut/kWp, mehrere mit ; getrennt. Azimut 0 = Süd, -90 = Ost, 90 = West
PV_FLAECHEN=30/0/10
# Balkonkraftwerk: Flächen wie PV_FLAECHEN (90 = senkrecht am Geländer), Einspeisegrenze des Wechselrichters
BKW_FLAECHEN=90/0/0.8
BKW_MAX_W=800
BATTERIE_KAPAZITAET_WH=10000
BATTERIE_MAX_W=5000
BATTERIE_MIN_SOC=10
WB_AKKU_KWH=60
WB_PHASEN=3
WB_MAX_A=16
WB_ABFAHRT=06:00
WB_ABFAHRT_TAGE=1,2,3,4,5

# ─── Strompreis ───
# Endpreis = Börsenpreis + ABGABEN_CT (Netzentgelt, Steuern, Umlagen, Marge, brutto; Tarif ansehen)
ABGABEN_CT=18
EINSPEISE_CT=8.0

# ─── Meldungen (ntfy.sh, kostenlos; App installieren und das Thema abonnieren) ───
# Thema schwer zu erraten wählen, z. B. radler-ems-<zufall>; leer = keine Meldungen, nur Log
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ─── InfluxDB (trägt deploy/influx_einrichten.sh ein) ───
INFLUX_TOKEN_NODERED=
INFLUX_TOKEN_GRAFANA=

# ─── Geräte (beim Hackathon ausfüllen, Namen nach Bedarf ergänzen) ───
WECHSELRICHTER_HOST=
WECHSELRICHTER_MODBUS_PORT=502
WECHSELRICHTER_MODBUS_UNIT=1
BKW_HOST=
BATTERIE_HOST=
WALLBOX_HOST=
WALLBOX_MODBUS_PORT=502
WP_HOST=
WP_USER=
WP_PASSWORD=
AUTO_USER=
AUTO_PASSWORD=
AUTO_VIN=
