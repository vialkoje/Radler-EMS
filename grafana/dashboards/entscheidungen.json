        "type": "influxdb",
        "uid": "radler-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "radler-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ems_ausfuehrung\" and r._field == \"grund\")\n  |> group()\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"Batterie\"})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "radler-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wallbox_plan\" and r._field == \"grund\")\n  |> group()\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"Wallbox\"})"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "radler-influx"
          },
          "query": "from(bucket: \"ems\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wp_steuerung\" and r._field == \"grund\")\n  |> group()\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"Wärmepumpe\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
